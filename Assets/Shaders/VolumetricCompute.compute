struct cloud_type
{
    float start_altitude;
    float coverage;
    float end_altitude;
    float height;
    float density;
};

cloud_type unpack(float4 v)
{
    cloud_type c;
    c.start_altitude = v.x;
    c.end_altitude = v.x + v.y;
    c.height = v.y;
    c.density = v.z;
    c.coverage = v.w;
    return c;
}

cloud_type unpack_lerp(float4 a, float4 b, float t)
{
    cloud_type c;
    c.start_altitude = lerp(a.x, b.x, t);
    c.end_altitude = lerp(a.x + a.y, b.x + b.y, t);
    c.height = lerp(a.y, b.y, t);
    c.density = lerp(a.z, b.z, t);
    c.coverage = lerp(a.w, b.w, t);
    return c;
}

float gradient_lerp(Texture2D<float> a, SamplerState a_sampler_state, Texture2D<float> b, SamplerState b_sampler_state,
                    float2 uv, float t)
{
    float a_value = a.SampleLevel(a_sampler_state, uv, 0);
    float b_value = b.SampleLevel(b_sampler_state, uv, 0);

    float result = lerp(a_value, b_value, t);
    return result;
}

static const uint2 pixel_shuffle[16] = {
    {0, 0}, {2, 2}, {2, 0}, {0, 2}, {1, 1}, {3, 3}, {3, 1}, {1, 3}, {1, 0}, {3, 2}, {3, 0}, {1, 2}, {0, 1}, {2, 3},
    {2, 1}, {0, 3}
};

float ign(float2 p)
{
    float3 magic = float3(0.06711056, 0.00583715, 52.9829189);
    return frac(magic.z * frac(dot(p, magic.xy)));
}

float henyey_greenstein_old(float g, float costh)
{
    float denominator = max(1.0 + g * g - (2.0 * g) * costh, 0.00001);
    return (1.0 - g * g) / (3.14 * pow(denominator, 1.5f));
}

float henyey_greenstein(float g, float costh)
{
    // Never negative, the max just keeps g = +-1 from dividing by zero.
    return ((1.0 - g * g) / pow(max(1 + g * g - 2.0 * g * costh, 1e-6), 1.5f)) / (4 * PI);
}

// Forward lobe gives the silver lining, back lobe keeps clouds lit when the sun is behind you.
float dual_lobe_phase(float g_forward, float g_back, float costh)
{
    return lerp(henyey_greenstein(g_forward, costh), henyey_greenstein(g_back, costh), back_scattering_weight);
}

float remap(float v, float inMin, float inMax, float outMin, float outMax)
{
    return outMin + (v - inMin) / (inMax - inMin) * (outMax - outMin);
}

float get_density(float3 worldPos, bool lowDetail = false)
{
    /*float4 weather = weather_map.SampleLevel(sampler_weather_map, worldPos.xz / 16000, 0);
    
    float height_frac = (worldPos.y - cumulus_y_min) / (cumulus_y_max - cumulus_y_min);
    float4 g = lerp(cloud_type_stratus, cloud_type_cumulus, saturate(current_cloud_type * 2.0));
    g = lerp(g, cloud_type_cumulonimbus, saturate(current_cloud_type * 2.0 - 1.0));
    float gradient = smoothstep(g.x, g.y, worldPos.y) - smoothstep(g.z, g.w, worldPos.y);
    
    if (gradient <= 0) return 0;
    
    
    float3 perlin_world_pos = float3(worldPos.x / _NoiseSize + time * base_speed, worldPos.y * _SquishFactor / _NoiseSize, worldPos.z / _NoiseSize);
    
    
    float4 perlin = _PerlinTex.SampleLevel(sampler_PerlinTex, perlin_world_pos , 0);
     
    
    float d = saturate(remap(perlin.a, _ShadowDensity, 1.0, 0.0, 1.0));
    d *= _DensityMultiplier;
    
    float3 texture1_worley_weights = float3(detail_fbm_weight1, detail_fbm_weight2, detail_fbm_weight3);
    float texture1_worley = 0;
    
    if (any(texture1_worley_weights > 0)) texture1_worley = (perlin.r * texture1_worley_weights.r + perlin.g * texture1_worley_weights.g + perlin.b * texture1_worley_weights.b) / (texture1_worley_weights.r + texture1_worley_weights.g + texture1_worley_weights.b);
    d = remap(d,min(-(texture1_worley),0) * detail_fbm_mult, 1.0, 0.0, 1);
    
    d *= gradient;
    
    float base_shape_with_coverage = remap(d, saturate(weather.r + coverage - 1), 1.0, 0.0, 1.0);
    base_shape_with_coverage *= weather.r;
    
    if (!lowDetail)
    {
        float3 texture2_worley_weights = float3(detail_weight1, detail_weight2, detail_weight3);
        float texture2_worley = 0;
        float3 worley_world_pos = float3(worldPos.x / _DetailSize + time * detail_speed, worldPos.y * _SquishFactor / _DetailSize, worldPos.z / _DetailSize);
        float4 worley = _WorleyTex.SampleLevel(sampler_WorleyTex, worley_world_pos, 0);  
        if (any(texture2_worley_weights > 0)) texture2_worley = (worley.r * texture2_worley_weights.r + worley.g * texture2_worley_weights.g + worley.b * texture2_worley_weights.b) / (texture2_worley_weights.r + texture2_worley_weights.g + texture2_worley_weights.b);
        base_shape_with_coverage = remap(base_shape_with_coverage, lerp(texture2_worley, -texture2_worley, height_frac) * detail_mult, 1.0, 0.0, 1);
    }
    
    if (base_shape_with_coverage <= _DensityThreshold) return 0;
    return base_shape_with_coverage * full_density_mult;*/

    /*float height_frac = (worldPos.y - cumulus_y_min) / (cumulus_y_max - cumulus_y_min);
    float4 g = lerp(cloud_type_stratus, cloud_type_cumulus, saturate(current_cloud_type * 2.0));
    g = lerp(g, cloud_type_cumulonimbus, saturate(current_cloud_type * 2.0 - 1.0));
    float gradient = smoothstep(g.x, g.y, worldPos.y) - smoothstep(g.z, g.w, worldPos.y);
    
    if (gradient <= 0) return 0;

    float3 perlin_world_pos = float3(worldPos.x / _NoiseSize + time * base_speed, worldPos.y * _SquishFactor / _NoiseSize, worldPos.z / _NoiseSize);
    
    
    float4 perlin = _PerlinTex.SampleLevel(sampler_PerlinTex, perlin_world_pos , 0);
    float3 texture1_worley_weights = float3(detail_fbm_weight1, detail_fbm_weight2, detail_fbm_weight3);
    float texture1_worley = 0;
    if (any(texture1_worley_weights > 0)) texture1_worley = (perlin.r * texture1_worley_weights.r + perlin.g * texture1_worley_weights.g + perlin.b * texture1_worley_weights.b) / (texture1_worley_weights.r + texture1_worley_weights.g + texture1_worley_weights.b);
    
    float base = perlin.a * gradient;
    base = remap(base, coverage,1.0, 0.0, 1.0);
    
    float result = base;
    result = remap(saturate(result), 1 - saturate(texture1_worley * detail_fbm_mult), 1.0, 0.0, 1.0);
    return saturate(result * full_density_mult);*/
    // Defaults give zero density in case the weather map ever holds a cloud type none of the branches handle.
    cloud_type cloud = unpack(cumulus_floats);

    float4 weather = weather_map.SampleLevel(sampler_weather_map, worldPos.xz / 128000 + weather_speed * time, 0);
    float sampled_cloud_type = weather.g * 2;
    float height_frac = 0;
    //float altitude = distance(worldPos, _SphereCenter) - _SphereMinRadius;
    float altitude = worldPos.y;
    float shapeGradient = 0;
    float densityGradient = 0;

    if (sampled_cloud_type == 0)
    {
        cloud = unpack(stratus_floats);
        height_frac = (altitude - cloud.start_altitude) / (cloud.end_altitude - cloud.start_altitude);
        if (height_frac < 0.0) return 0;
        shapeGradient = stratus_shape_lut.SampleLevel(sampler_stratus_shape_lut, float2(height_frac, 0.5), 0);
        densityGradient = stratus_density_lut.SampleLevel(sampler_stratus_density_lut, float2(height_frac, 0.5), 0);
    }
    else if (sampled_cloud_type == 1)
    {
        cloud = unpack(stratocumulus_floats);
        height_frac = (altitude - cloud.start_altitude) / (cloud.end_altitude - cloud.start_altitude);
        if (height_frac < 0.0) return 0;
        shapeGradient = stratocumulus_shape_lut.SampleLevel(sampler_stratocumulus_shape_lut, float2(height_frac, 0.5),
                                                            0);
        densityGradient = stratocumulus_density_lut.SampleLevel(sampler_stratocumulus_density_lut,
                                                                float2(height_frac, 0.5), 0);
    }
    else if (sampled_cloud_type == 2)
    {
        cloud = unpack(cumulus_floats);
        height_frac = (altitude - cloud.start_altitude) / (cloud.end_altitude - cloud.start_altitude);
        if (height_frac < 0.0) return 0;
        shapeGradient = cumulus_shape_lut.SampleLevel(sampler_cumulus_shape_lut, float2(height_frac, 0.5), 0);
        densityGradient = cumulus_density_lut.SampleLevel(sampler_cumulus_density_lut, float2(height_frac, 0.5), 0);
    }

    else if (sampled_cloud_type < 1)
    {
        float t = sampled_cloud_type;
        cloud = unpack_lerp(stratus_floats, stratocumulus_floats, t);
        height_frac = (altitude - cloud.start_altitude) / (cloud.end_altitude - cloud.start_altitude);
        if (height_frac < 0.0) return 0;
        shapeGradient = stratus_shape_lut.SampleLevel(sampler_stratus_shape_lut, float2(height_frac, 0.5), 0);
        densityGradient = stratus_density_lut.SampleLevel(sampler_stratus_density_lut, float2(height_frac, 0.5), 0);
    }
    else if (sampled_cloud_type < 2)
    {
        float t = sampled_cloud_type - 1;
        cloud = unpack_lerp(stratocumulus_floats, cumulus_floats, t);
        height_frac = (altitude - cloud.start_altitude) / (cloud.end_altitude - cloud.start_altitude);
        if (height_frac < 0.0) return 0;
        shapeGradient = gradient_lerp(stratocumulus_shape_lut, sampler_stratocumulus_shape_lut,
                                      cumulus_shape_lut, sampler_cumulus_shape_lut, float2(height_frac, 0.5), t);
        densityGradient = gradient_lerp(stratocumulus_density_lut, sampler_stratocumulus_density_lut,
                                        cumulus_density_lut, sampler_cumulus_density_lut, float2(height_frac, 0.5), t);
    }
    last_height_frac = height_frac;

    if ((1 - coverage) + weather.r >= 1.0) return 0;
    worldPos.x += saturate(height_frac) * wind_shear; // Tops lean downwind (the noise scrolls towards -x).

    float3 perlin_world_pos = float3(worldPos.x / _NoiseSize + time * base_speed,
                                     worldPos.y * _SquishFactor / _NoiseSize, worldPos.z / _NoiseSize);
    float4 perlin = _PerlinTex.SampleLevel(sampler_PerlinTex, perlin_world_pos, 0);
    float detail = perlin.r * 0.625 + perlin.g * 0.25 + perlin.b * 0.125;

    //float base = saturate(perlin.a - coverage - gradient - weather.r);
    float base = perlin.a;
    base = remap(base, (1 - detail) * detail_fbm_mult, 1.0, 0.0, 1.0);
    base = base * shapeGradient;
    base = saturate(remap(base, saturate((1 - coverage) + weather.r - cloud.coverage), 1.0, 0.0, 1.0));
    // The detail can only erode, so an empty base stays empty and the detail sample can be skipped.
    if (base <= 0) return 0;
    // Cheap version for the long shadow sample and the ground shadows: erode by the average detail instead.
    if (lowDetail) return max(remap(base, 0.5 * detail_mult, 1.0, 0.0, 1.0) * full_density_mult * cloud.density * densityGradient, 0.0);
    float3 low_quality_detail_rgb = _WorleyTex.SampleLevel(sampler_WorleyTex,
                                                           worldPos / _DetailSize + time * detail_speed, 0).rgb;
    float low_quality_detail = low_quality_detail_rgb.r * 0.625 + low_quality_detail_rgb.g * 0.25 +
        low_quality_detail_rgb.b * 0.125;
    low_quality_detail = lerp(low_quality_detail, 1 - low_quality_detail, saturate(height_frac * 10));
    float result = remap(base, low_quality_detail * detail_mult, 1.0, 0.0, 1.0);


    return max(result * full_density_mult * cloud.density * densityGradient, 0.0);
}

float2 get_box_bounds(float3 worldPos, float3 rayDir)
{
    float3 tl = float3((_MinBounds.x - worldPos.x) / rayDir.x, (_MinBounds.y - worldPos.y) / rayDir.y,
                       (_MinBounds.z - worldPos.z) / rayDir.z);
    float3 th = float3((_MaxBounds.x - worldPos.x) / rayDir.x, (_MaxBounds.y - worldPos.y) / rayDir.y,
                       (_MaxBounds.z - worldPos.z) / rayDir.z);

    float tc = max(min(tl.x, th.x), max(min(tl.y, th.y), min(tl.z, th.z)));
    float tf = min(max(tl.x, th.x), min(max(tl.y, th.y), max(tl.z, th.z)));

    return float2(tc, tf);
}

float2 get_sphere_bounds(float3 worldPos, float3 rayDir, float radius)
{
    float b = 2 * dot((worldPos.xyz - _SphereCenter.xyz), rayDir.xyz);
    float c = dot((worldPos.xyz - _SphereCenter.xyz), (worldPos.xyz - _SphereCenter.xyz)) - pow(radius, 2);
    float h = pow(b, 2) - 4 * c;
    if (h <= 0) return float2(-1, -1);
    float t1 = (-b - sqrt(h)) / 2;
    float t2 = (-b + sqrt(h)) / 2;
    return float2(t1, t2);
}

float get_bounds_intersect(float3 pos, float3 rayDir)
{
    float2 sphere1intersect = get_sphere_bounds(pos, rayDir, _SphereMinRadius);
    float2 sphere2intersect = get_sphere_bounds(pos, rayDir, _SphereMaxRadius);
    float2 boxIntersect = get_box_bounds(pos, rayDir);


    float tEnter = max(0.0, sphere2intersect.x);
    float tExit = sphere2intersect.y;

    // The sphere is behind the player.
    if (tExit <= tEnter) return -1;

    if (combine_bounds)
    {
        tEnter = max(tEnter, boxIntersect.x);
        tExit = min(tExit, boxIntersect.y);
        if (tExit <= tEnter) return -1;
    }

    float2 seg0 = float2(tEnter, tExit);


    float innerA = sphere1intersect.x;
    float innerB = sphere1intersect.y;
    bool innerHits = innerB > 0 && innerA < innerB;

    if (innerHits)
    {
        innerA = max(innerA, tEnter);
        innerB = min(innerB, tExit);
        if (innerA < innerB)
        {
            bool clipsStart = innerA <= tEnter;
            bool clipsEnd = innerB >= tExit;
            if (clipsStart && clipsEnd) return -1; // The box is fully inside the smaller sphere.
            else if (clipsStart) seg0.x = innerB;
        }
    }

    return seg0.x;
}

float3 calculateWorldPos(float2 uv, float depth, float4x4 inv_vp)
{
    float4 ndc = float4(uv * 2.0 - 1.0, depth, 1.0);
    float4 worldPos = mul(inv_vp, ndc);
    return worldPos.xyz / worldPos.w;
}

float4 raymarch(float3 startPoint, float3 endPoint, float3 camPoint, float3 fogCol, float stepSize, int maxSteps,
                float viewLength, float transmittance, float2 id, inout float2 depth_acc)
{
    float sun_elevation = -_LightDirection.y;
    float t = smoothstep(0.0, 0.25, sun_elevation);
    float sun_up = smoothstep(-0.1, 0.05, sun_elevation);
    // x3 keeps Light Contribution about as bright as the old beer-powder lighting.
    float3 light_contribution = lerp(light_contribution_sunset.rgb, light_contribution_day.rgb, t) * _MainLightColor.rgb * sun_up * 3.0;
    float3 ambient_color = lerp(fog_base_color_night.rgb, fog_base_color_day.rgb, sun_up);
    float distanceTravelled = ign(id) * stepSize;
    float3 rayDir = normalize(endPoint - startPoint);
    float startDist = distance(startPoint, camPoint);
    if (startDist > viewLength) return float4(fogCol, transmittance);
    // Stop where the scene depth is, so terrain in front of the clouds hides them.
    float maxDist = min(distance(startPoint, endPoint), viewLength - startDist);

    float cos_theta = dot(rayDir, -_LightDirection.xyz);
    int steps = 0;
    float3 fogColor = fogCol;

    // Stops at 1% transmittance, what is left behind that can't be seen anyway.
    while (distanceTravelled < maxDist && steps < maxSteps && transmittance > 0.01)
    {
        float3 worldPos = startPoint + rayDir * distanceTravelled;
        distanceTravelled += stepSize;
        steps++;
        float density = get_density(worldPos);
        if (density <= 0) continue;
        float height_frac = saturate(last_height_frac);
        float3 shadowRayDir = normalize(-_LightDirection.xyz);
        float3 shadowRayEntryPos = worldPos + shadowRayDir * ign(id.xy) * shadow_step_size;
        float shadow_od = 0;
        float shadow_distance_travelled = 0;
        float3 right = normalize(cross(shadowRayDir, float3(0, 1, 0)));
        float3 up = normalize(cross(shadowRayDir, right));
        float2 a[6] = {
            normalize(float2(-0.6, 0.94)), normalize(float2(-0.97, -0.28)), normalize(float2(0.19, -0.71)),
            normalize(float2(-0.73, -0.2)), normalize(float2(0.42, -0.38)), normalize(float2(-0.81, 0.19))
        };

        for (int i = 1; i <= 6; i++)
        {
            //float step_size = i * shadow_step_size;
            float step_size = shadow_step_size * (i == 6 ? 3 : 1);
            shadow_distance_travelled += step_size;
            float3 shadowRayPos = shadowRayEntryPos + shadowRayDir * shadow_distance_travelled + right *
                shadow_distance_travelled * shadow_cone_spread * a[i - 1].x + up * shadow_distance_travelled *
                shadow_cone_spread * a[i - 1].y;
            float shadowDensity;
            if (i < 6) shadowDensity = get_density(shadowRayPos) * step_size;
            else shadowDensity = get_density(shadowRayPos, true) * step_size;
            shadow_od += shadowDensity;
        }

        // Multiple scattering (Wrenninge 2013): every octave goes deeper, scatters less and more evenly.
        float sun_light = 0;
        float extinction = 1, scattering = 1, eccentricity = 1;
        for (int o = 0; o < 3; o++)
        {
            sun_light += scattering * exp(-shadow_od * extinction) *
                dual_lobe_phase(_LightScattering * eccentricity, back_scattering * eccentricity, cos_theta);
            extinction *= 0.5;
            scattering *= 0.5;
            eccentricity *= 0.5;
        }
        // Powder darkens edges when the sun is behind you, fades out when looking towards the sun.
        float powder = lerp(1.0, 1.0 - exp(-2.0 * shadow_od), powder_strength * saturate(0.5 - 0.5 * cos_theta));
        float3 ambient = ambient_color * lerp(ambient_bottom, 1.0, height_frac);
        // Fade far samples out so the horizon turns into haze instead of noise.
        float cam_distance = distance(worldPos, camPoint);
        float fade = exp(-cam_distance / max(horizon_fade, 1.0));
        float step_opacity = (1.0 - exp(-density * stepSize)) * fade;
        // Average distance weighted by how much each step shows up in the final pixel.
        depth_acc += float2(cam_distance, 1.0) * (transmittance * step_opacity);
        // Energy conserving integration (Hillaire 2015), looks the same no matter the step size.
        fogColor.rgb += transmittance * step_opacity * (light_contribution * sun_light * powder + ambient);
        transmittance *= 1.0 - step_opacity;
    }
    return float4(fogColor.rgb, transmittance);
}

[numthreads(8,8,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    // The dispatch is rounded up, so threads past the edge have nothing to do.
    if (any(id.xy >= (uint2)cloud_size.zw)) return;
    Result[id.xy] = float4(0.0, 0.0, 0.0, 0.0);
    ResultDepth[id.xy] = 0.0;

    // With temporal upscaling each thread renders one pixel of a 4x4 block, a different one every frame.
    uint2 pixel = use_temporal_upscaling ? id.xy * 4 + pixel_shuffle[pixel_offset] : id.xy;
    if (any(pixel >= (uint2)cloud_size.xy)) return;
    float2 uv = (pixel + 0.5) / cloud_size.xy;
    // Moving the jitter every frame lets the Resolve kernel average the noise away (Jimenez 2014).
    float2 jitter_id = pixel + (frame_index & 63) * 5.588238;

    float depth = DepthTex.SampleLevel(sampler_DepthTex, uv, 0).r;
    float3 worldPos = calculateWorldPos(uv, depth, _InvVP);
    float3 entryPos = _CamPos.xyz;
    float3 viewDir = worldPos - entryPos;
    float viewLength = abs(depth - sky_depth) < 1e-7 ? _MaxDistance : length(viewDir);
    float3 rayDir = normalize(viewDir);


    if (_UseBoundingSphere)
    {
        float2 sphere1intersect = get_sphere_bounds(entryPos, rayDir, _SphereMinRadius);
        float2 sphere2intersect = get_sphere_bounds(entryPos, rayDir, _SphereMaxRadius);
        float2 boxIntersect = get_box_bounds(entryPos, rayDir);


        float tEnter = max(0.0, sphere2intersect.x);
        float tExit = sphere2intersect.y;

        // The sphere is behind the player.
        if (tExit <= tEnter) return;

        if (combine_bounds)
        {
            tEnter = max(tEnter, boxIntersect.x);
            tExit = min(tExit, boxIntersect.y);
            if (tExit <= tEnter) return;
        }

        float2 seg0 = float2(tEnter, tExit);
        float2 seg1 = float2(0.0, 0.0);
        bool split = false;

        float innerA = sphere1intersect.x;
        float innerB = sphere1intersect.y;
        bool innerHits = innerB > 0 && innerA < innerB;

        if (innerHits)
        {
            innerA = max(innerA, tEnter);
            innerB = min(innerB, tExit);
            if (innerA < innerB)
            {
                bool clipsStart = innerA <= tEnter;
                bool clipsEnd = innerB >= tExit;
                if (clipsStart && clipsEnd) return; // The box is fully inside the smaller sphere.
                else if (clipsStart) seg0.x = innerB;
                else if (clipsEnd) seg0.y = innerA;
                else
                {
                    seg0.y = innerA;
                    seg1 = float2(innerB, tExit);
                    split = true;
                }
            }
        }

        float steps = split ? _StepAmount * 0.5 : _StepAmount;
        float3 a0 = entryPos + rayDir * seg0.x;
        float3 b0 = entryPos + rayDir * seg0.y;
        // Starts at 0, the result is premultiplied (ambient is added inside the march now).
        float2 depth_acc = float2(0.0, 0.0);
        float4 res = raymarch(a0, b0, entryPos, float3(0, 0, 0),
                              distance(a0, b0) / steps, steps, viewLength, 1.0, jitter_id, depth_acc);
        if (split)
        {
            float3 a1 = entryPos + rayDir * seg1.x;
            float3 b1 = entryPos + rayDir * seg1.y;
            res = raymarch(a1, b1, entryPos, res.rgb, distance(a1, b1) / steps, steps, viewLength, res.a, jitter_id,
                           depth_acc);
        }
        Result[id.xy] = float4(res.rgb, 1.0 - saturate((res.a <= 0.01 ? 0 : res.a)));
        ResultDepth[id.xy] = depth_acc.y > 0.001 ? depth_acc.x / depth_acc.y : 0.0;
    }
}

// Bicubic (Catmull-Rom) sample made from 9 bilinear taps. The history gets resampled every frame,
// with plain bilinear it would slowly blur.
float4 sample_catmull_rom(Texture2D<float4> tex, float2 uv, float2 size)
{
    float2 sample_pos = uv * size;
    float2 tex_pos1 = floor(sample_pos - 0.5) + 0.5;
    float2 f = sample_pos - tex_pos1;

    float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    float2 w3 = f * f * (-0.5 + 0.5 * f);
    float2 w12 = w1 + w2;

    float2 tex_pos0 = (tex_pos1 - 1.0) / size;
    float2 tex_pos3 = (tex_pos1 + 2.0) / size;
    float2 tex_pos12 = (tex_pos1 + w2 / w12) / size;

    float4 result = 0;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos0.x, tex_pos0.y), 0) * w0.x * w0.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos12.x, tex_pos0.y), 0) * w12.x * w0.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos3.x, tex_pos0.y), 0) * w3.x * w0.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos0.x, tex_pos12.y), 0) * w0.x * w12.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos12.x, tex_pos12.y), 0) * w12.x * w12.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos3.x, tex_pos12.y), 0) * w3.x * w12.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos0.x, tex_pos3.y), 0) * w0.x * w3.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos12.x, tex_pos3.y), 0) * w12.x * w3.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos3.x, tex_pos3.y), 0) * w3.x * w3.y;
    return result;
}

// Blends this frame's raymarch into last frame's result. Smooths out the jitter noise and, with temporal
// upscaling, builds the full resolution image from the sparse samples over several frames.
[numthreads(8,8,1)]
void Resolve(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)cloud_size.xy)) return;

    int2 current_max = (int2)cloud_size.zw - 1;
    int2 center_id = min(use_temporal_upscaling ? (int2)(id.xy / 4) : (int2)id.xy, current_max);
    // Where this frame's samples sit: every pixel, or one per 4x4 block at this frame's offset.
    float sample_spacing = use_temporal_upscaling ? 4.0 : 1.0;
    float2 sample_offset = use_temporal_upscaling ? (float2)pixel_shuffle[pixel_offset] : float2(0.0, 0.0);

    // Look at this frame's samples around the pixel: their range clamps the history (stops ghosting),
    // their distance weighted average is the new value when upscaling, and their depth drives the reprojection.
    float4 center = current_frame[center_id];
    float4 neighbour_min = center;
    float4 neighbour_max = center;
    float4 estimate = float4(0.0, 0.0, 0.0, 0.0);
    float estimate_weight = 0.0;
    float depth_sum = 0.0;
    float depth_weight = 0.0;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            int2 sample_id = clamp(center_id + int2(x, y), 0, current_max);
            float4 neighbour = current_frame[sample_id];
            float neighbour_depth = current_depth[sample_id];
            neighbour_min = min(neighbour_min, neighbour);
            neighbour_max = max(neighbour_max, neighbour);

            // Gaussian with a 0.8 pixel radius, picked by simulating the upsampler on a real screenshot.
            float2 to_sample = (float2)sample_id * sample_spacing + sample_offset - (float2)id.xy;
            float weight = exp(-dot(to_sample, to_sample) * 0.78125);
            estimate += neighbour * weight;
            estimate_weight += weight;
            if (neighbour_depth > 0.0)
            {
                depth_sum += neighbour_depth * weight;
                depth_weight += weight;
            }
        }
    }

    // Without upscaling every pixel has its own fresh sample. With upscaling a pixel only gets a close
    // sample every few frames, so it takes a bigger share of whatever is near it this frame.
    float4 current = use_temporal_upscaling ? estimate / estimate_weight : center;
    float blend = use_temporal_upscaling ? saturate(saturate(temporal_blend * 5.0) * estimate_weight) : temporal_blend;

    // Where were these clouds last frame? Uses the raymarched cloud distance, so flying around reprojects
    // correctly. Pixels without clouds nearby fall back to the cloud layer entry (any distance works for rotation).
    float2 uv = (id.xy + 0.5) / cloud_size.xy;
    float3 ray_dir = normalize(calculateWorldPos(uv, 0.5, _InvVP) - _CamPos.xyz);
    float cloud_distance = depth_weight > 0.0 ? depth_sum / depth_weight
                                              : max(get_bounds_intersect(_CamPos.xyz, ray_dir), 1000.0);
    float3 cloud_pos = _CamPos.xyz + ray_dir * cloud_distance + wind_offset.xyz;
    float4 prev_clip = mul(prev_vp, float4(cloud_pos, 1.0));
    float2 prev_uv = prev_clip.xy / prev_clip.w * 0.5 + 0.5;
    bool on_screen = prev_clip.w > 0 && all(prev_uv >= 0) && all(prev_uv <= 1);

    if (!history_valid || !on_screen) blend = 1.0;

    // Selected instead of lerped so garbage in a freshly created history texture can't leak through.
    if (blend >= 1.0)
    {
        Result[id.xy] = current;
        return;
    }
    float4 history = clamp(sample_catmull_rom(rendertexture_old, prev_uv, cloud_size.xy), neighbour_min, neighbour_max);
    Result[id.xy] = lerp(history, current, blend);
}

[numthreads(8,8,1)]
void CloudsShadows(uint3 id : SV_DispatchThreadID)
{
    float2 worldXZ = shadow_center.xy + ((id.xy + 0.5) / shadow_resolution - 0.5) * shadow_world_size;
    float3 shadow_start_pos = float3(worldXZ.x, _MinBounds.y, worldXZ.y);
    float3 rayDir = normalize(-_LightDirection.xyz);

    float2 box_intersect = get_box_bounds(shadow_start_pos, rayDir);

    float3 endPoint = shadow_start_pos + rayDir * box_intersect.y;

    int steps = 0;
    float optical_depth = 0.0;

    float step_size = distance(shadow_start_pos, endPoint) / shadow_steps;

    while (steps < shadow_steps)
    {
        float3 p = shadow_start_pos + rayDir * step_size * (steps + 0.5);
        optical_depth += get_density(p, true) * step_size;
        steps++;
    }

    //shadowRT[id.xy] = frac(worldXZ.x * 0.001);
    shadowRT[id.xy] = exp(-optical_depth);
    //shadowRT[id.xy] = (id.x + 0.5) / shadow_resolution;
}
