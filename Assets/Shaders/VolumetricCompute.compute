struct cloud_type
{
    float start_altitude;
    float coverage;
    float end_altitude;
    float height;
    float density;
};

cloud_type unpack(float4 v)
{
    cloud_type c;
    c.start_altitude = v.x;
    c.end_altitude = v.x + v.y;
    c.height = v.y;
    c.density = v.z;
    c.coverage = v.w;
    return c;
}

cloud_type unpack_lerp(float4 a, float4 b, float t)
{
    cloud_type c;
    c.start_altitude = lerp(a.x, b.x, t);
    c.end_altitude = lerp(a.x + a.y, b.x + b.y, t);
    c.height = lerp(a.y, b.y, t);
    c.density = lerp(a.z, b.z, t);
    c.coverage = lerp(a.w, b.w, t);
    return c;
}

float gradient_lerp(Texture2D<float> a, SamplerState a_sampler_state, Texture2D<float> b, SamplerState b_sampler_state,
                    float2 uv, float t)
{
    float a_value = a.SampleLevel(a_sampler_state, uv, 0);
    float b_value = b.SampleLevel(b_sampler_state, uv, 0);

    float result = lerp(a_value, b_value, t);
    return result;
}

static const uint2 pixel_shuffle[16] = {
    {0, 0}, {2, 2}, {2, 0}, {0, 2}, {1, 1}, {3, 3}, {3, 1}, {1, 3}, {1, 0}, {3, 2}, {3, 0}, {1, 2}, {0, 1}, {2, 3},
    {2, 1}, {0, 3}
};

uint upscale_block()
{
    return (uint)max(upscale_factor, 1);
}

// This frame's sample position inside its upscale block. The first 4 entries of the 4x4 order, halved, are a 2x2 order.
uint2 upscale_offset()
{
    uint2 offset = uint2(0, 0);
    if (upscale_factor >= 4) offset = pixel_shuffle[pixel_offset % 16];
    else if (upscale_factor == 2) offset = pixel_shuffle[pixel_offset % 4] / 2;
    return offset;
}

float ign(float2 p)
{
    float3 magic = float3(0.06711056, 0.00583715, 52.9829189);
    return frac(magic.z * frac(dot(p, magic.xy)));
}

float henyey_greenstein_old(float g, float costh)
{
    float denominator = max(1.0 + g * g - (2.0 * g) * costh, 0.00001);
    return (1.0 - g * g) / (3.14 * pow(denominator, 1.5f));
}

float henyey_greenstein(float g, float costh)
{
    // Never negative, the max just keeps g = +-1 from dividing by zero.
    return ((1.0 - g * g) / pow(max(1 + g * g - 2.0 * g * costh, 1e-6), 1.5f)) / (4 * PI);
}

// Forward lobe gives the silver lining, back lobe keeps clouds lit when the sun is behind you.
float dual_lobe_phase(float g_forward, float g_back, float costh)
{
    return lerp(henyey_greenstein(g_forward, costh), henyey_greenstein(g_back, costh), back_scattering_weight);
}

float remap(float v, float inMin, float inMax, float outMin, float outMax)
{
    return outMin + (v - inMin) / (inMax - inMin) * (outMax - outMin);
}

// Storm cells, round and not overlapping, over the same 128 km tile as the weather map (storm_cell bends their outlines).
// r: 1 in the middle of a cell fading to 0 at its edge, g: the cell's random value, which decides if it is active.
Texture2D<float2> storm_map;
SamplerState sampler_storm_map;
// x: how much the active cells grow into towers (0 = no storms), y: share of the cells that are active.
float4 storm_params;
// x: rain amount (0 = no rain), y: coverage, z: towers, w: share of active storm cells (same as _CloudRain).
float4 rain_params;
// Height of the cloud base, the rain falls below it.
float rain_base;

// The shapes of the storm clouds, drawn by the AnvilMap kernel over the same tile as the storm map. x: the anvils,
// y: where the towers stand (0 to 1 rising at their rim, times the weather's towers), z: how tall they are there (0 to 1
// of the extra 1.4 cumulus heights), w: the height of the anvil's storm, blended between neighbouring anvils.
Texture2D<float4> anvil_map;
RWTexture2D<float4> anvil_map_out;
SamplerState sampler_linear_repeat;
// Every storm cell: xy its centre and z its radius in grid cells, w its random value (the same as the storm map's g).
float4 storm_cells[144];
// More random values per cell, 0 to 1. x: its height, y: the direction of its flanking line, z: below 0.7 it has one.
float4 storm_cells_extra[144];
// x: share of the cells that are active (as storm_params.y), y: towers, zw: the wind direction.
float4 anvil_params;

// The uv of the storm maps at p (world xz minus wind_travel), with the outlines bent so the cells aren't circles
// (CloudRain.hlsl).
float2 storm_uv(float2 p)
{
    float2 noise = weather_map.SampleLevel(sampler_weather_map, p / STORM_WARP_SCALE, STORM_WARP_MIP).ba;
    return storm_warp(p, noise) / 128000;
}

float2 storm_cell(float2 p)
{
    return storm_map.SampleLevel(sampler_storm_map, storm_uv(p), 0);
}

// detail_amount 1 = full detail, 0 = erode by the average detail instead, which skips the detail texture (distance LOD
// and the cheap shadow samples). bound_only returns the density before the detail erodes it: the detail can only take
// density away, so where this is 0 the full density is 0 too.
float get_density(float3 worldPos, float detail_amount = 1.0, bool bound_only = false)
{
    last_bound = 0;
    /*float4 weather = weather_map.SampleLevel(sampler_weather_map, worldPos.xz / 16000, 0);
    
    float height_frac = (worldPos.y - cumulus_y_min) / (cumulus_y_max - cumulus_y_min);
    float4 g = lerp(cloud_type_stratus, cloud_type_cumulus, saturate(current_cloud_type * 2.0));
    g = lerp(g, cloud_type_cumulonimbus, saturate(current_cloud_type * 2.0 - 1.0));
    float gradient = smoothstep(g.x, g.y, worldPos.y) - smoothstep(g.z, g.w, worldPos.y);
    
    if (gradient <= 0) return 0;
    
    
    float3 perlin_world_pos = float3(worldPos.x / _NoiseSize + time * base_speed, worldPos.y * _SquishFactor / _NoiseSize, worldPos.z / _NoiseSize);
    
    
    float4 perlin = _PerlinTex.SampleLevel(sampler_PerlinTex, perlin_world_pos , 0);
     
    
    float d = saturate(remap(perlin.a, _ShadowDensity, 1.0, 0.0, 1.0));
    d *= _DensityMultiplier;
    
    float3 texture1_worley_weights = float3(detail_fbm_weight1, detail_fbm_weight2, detail_fbm_weight3);
    float texture1_worley = 0;
    
    if (any(texture1_worley_weights > 0)) texture1_worley = (perlin.r * texture1_worley_weights.r + perlin.g * texture1_worley_weights.g + perlin.b * texture1_worley_weights.b) / (texture1_worley_weights.r + texture1_worley_weights.g + texture1_worley_weights.b);
    d = remap(d,min(-(texture1_worley),0) * detail_fbm_mult, 1.0, 0.0, 1);
    
    d *= gradient;
    
    float base_shape_with_coverage = remap(d, saturate(weather.r + coverage - 1), 1.0, 0.0, 1.0);
    base_shape_with_coverage *= weather.r;
    
    if (!lowDetail)
    {
        float3 texture2_worley_weights = float3(detail_weight1, detail_weight2, detail_weight3);
        float texture2_worley = 0;
        float3 worley_world_pos = float3(worldPos.x / _DetailSize + time * detail_speed, worldPos.y * _SquishFactor / _DetailSize, worldPos.z / _DetailSize);
        float4 worley = _WorleyTex.SampleLevel(sampler_WorleyTex, worley_world_pos, 0);  
        if (any(texture2_worley_weights > 0)) texture2_worley = (worley.r * texture2_worley_weights.r + worley.g * texture2_worley_weights.g + worley.b * texture2_worley_weights.b) / (texture2_worley_weights.r + texture2_worley_weights.g + texture2_worley_weights.b);
        base_shape_with_coverage = remap(base_shape_with_coverage, lerp(texture2_worley, -texture2_worley, height_frac) * detail_mult, 1.0, 0.0, 1);
    }
    
    if (base_shape_with_coverage <= _DensityThreshold) return 0;
    return base_shape_with_coverage * full_density_mult;*/

    /*float height_frac = (worldPos.y - cumulus_y_min) / (cumulus_y_max - cumulus_y_min);
    float4 g = lerp(cloud_type_stratus, cloud_type_cumulus, saturate(current_cloud_type * 2.0));
    g = lerp(g, cloud_type_cumulonimbus, saturate(current_cloud_type * 2.0 - 1.0));
    float gradient = smoothstep(g.x, g.y, worldPos.y) - smoothstep(g.z, g.w, worldPos.y);
    
    if (gradient <= 0) return 0;

    float3 perlin_world_pos = float3(worldPos.x / _NoiseSize + time * base_speed, worldPos.y * _SquishFactor / _NoiseSize, worldPos.z / _NoiseSize);
    
    
    float4 perlin = _PerlinTex.SampleLevel(sampler_PerlinTex, perlin_world_pos , 0);
    float3 texture1_worley_weights = float3(detail_fbm_weight1, detail_fbm_weight2, detail_fbm_weight3);
    float texture1_worley = 0;
    if (any(texture1_worley_weights > 0)) texture1_worley = (perlin.r * texture1_worley_weights.r + perlin.g * texture1_worley_weights.g + perlin.b * texture1_worley_weights.b) / (texture1_worley_weights.r + texture1_worley_weights.g + texture1_worley_weights.b);
    
    float base = perlin.a * gradient;
    base = remap(base, coverage,1.0, 0.0, 1.0);
    
    float result = base;
    result = remap(saturate(result), 1 - saturate(texture1_worley * detail_fbm_mult), 1.0, 0.0, 1.0);
    return saturate(result * full_density_mult);*/
    // Defaults give zero density in case the weather map ever holds a cloud type none of the branches handle.
    cloud_type cloud = unpack(cumulus_floats);

    float4 weather = weather_map.SampleLevel(sampler_weather_map, (worldPos.xz - wind_travel.xz) / 128000, 0);
    float sampled_cloud_type = weather.g * 2;
    // Storm cells (only when the weather has towers): a broad tower rises from the cell and an anvil spreads at the top.
    // x: anvil, y: where the towers stand, z: their height, w: the anvil's storm height (see AnvilMap).
    float4 storm_shapes = float4(0.0, 0.0, 0.0, 0.0);
    float2 storm_tex_uv = float2(0.0, 0.0);
    if (storm_params.x > 0)
    {
        storm_tex_uv = storm_uv(worldPos.xz - wind_travel.xz);
        storm_shapes = anvil_map.SampleLevel(sampler_linear_repeat, storm_tex_uv, 0);
    }
    float dome = storm_shapes.y;
    float tower = 1.0 + 1.4 * storm_shapes.z;
    float cell_coverage = saturate(coverage + 0.2 * dome);
    float height_frac = 0;
    //float altitude = distance(worldPos, _SphereCenter) - _SphereMinRadius;
    float altitude = worldPos.y;
    float shapeGradient = 0;
    float densityGradient = 0;

    if (sampled_cloud_type == 0)
    {
        cloud = unpack(stratus_floats);
        height_frac = (altitude - cloud.start_altitude) / ((cloud.end_altitude - cloud.start_altitude) * tower);
        if (height_frac < 0.0) return 0;
        shapeGradient = stratus_shape_lut.SampleLevel(sampler_stratus_shape_lut, float2(height_frac, 0.5), 0);
        densityGradient = stratus_density_lut.SampleLevel(sampler_stratus_density_lut, float2(height_frac, 0.5), 0);
    }
    else if (sampled_cloud_type == 1)
    {
        cloud = unpack(stratocumulus_floats);
        height_frac = (altitude - cloud.start_altitude) / ((cloud.end_altitude - cloud.start_altitude) * tower);
        if (height_frac < 0.0) return 0;
        shapeGradient = stratocumulus_shape_lut.SampleLevel(sampler_stratocumulus_shape_lut, float2(height_frac, 0.5),
                                                            0);
        densityGradient = stratocumulus_density_lut.SampleLevel(sampler_stratocumulus_density_lut,
                                                                float2(height_frac, 0.5), 0);
    }
    else if (sampled_cloud_type == 2)
    {
        cloud = unpack(cumulus_floats);
        height_frac = (altitude - cloud.start_altitude) / ((cloud.end_altitude - cloud.start_altitude) * tower);
        if (height_frac < 0.0) return 0;
        shapeGradient = cumulus_shape_lut.SampleLevel(sampler_cumulus_shape_lut, float2(height_frac, 0.5), 0);
        densityGradient = cumulus_density_lut.SampleLevel(sampler_cumulus_density_lut, float2(height_frac, 0.5), 0);
    }

    else if (sampled_cloud_type < 1)
    {
        float t = sampled_cloud_type;
        cloud = unpack_lerp(stratus_floats, stratocumulus_floats, t);
        height_frac = (altitude - cloud.start_altitude) / ((cloud.end_altitude - cloud.start_altitude) * tower);
        if (height_frac < 0.0) return 0;
        shapeGradient = stratus_shape_lut.SampleLevel(sampler_stratus_shape_lut, float2(height_frac, 0.5), 0);
        densityGradient = stratus_density_lut.SampleLevel(sampler_stratus_density_lut, float2(height_frac, 0.5), 0);
    }
    else if (sampled_cloud_type < 2)
    {
        float t = sampled_cloud_type - 1;
        cloud = unpack_lerp(stratocumulus_floats, cumulus_floats, t);
        height_frac = (altitude - cloud.start_altitude) / ((cloud.end_altitude - cloud.start_altitude) * tower);
        if (height_frac < 0.0) return 0;
        shapeGradient = gradient_lerp(stratocumulus_shape_lut, sampler_stratocumulus_shape_lut,
                                      cumulus_shape_lut, sampler_cumulus_shape_lut, float2(height_frac, 0.5), t);
        densityGradient = gradient_lerp(stratocumulus_density_lut, sampler_stratocumulus_density_lut,
                                        cumulus_density_lut, sampler_cumulus_density_lut, float2(height_frac, 0.5), t);
    }
    last_height_frac = height_frac;
    if (storm_params.x > 0)
    {
        // Towers keep their full width up to 80% of their height and then round off, a blunt top.
        float column = 1.0 - smoothstep(0.8, 1.0, height_frac);
        shapeGradient = lerp(shapeGradient, column, dome);
        // Height in the tallest tower of the anvil's storm, the anvil sits near its top.
        cloud_type cu = unpack(cumulus_floats);
        float anvil_frac = (altitude - cu.start_altitude) / (cu.height * (1.0 + 1.4 * storm_shapes.w));
        bool near_anvil = anvil_frac > 0.5 && anvil_frac < 0.93 && storm_shapes.x > 0;
        if (dome > 0 || near_anvil)
        {
            // Billows of their own: the base noise is far too smooth at the size of a tower.
            float billow = _PerlinTex.SampleLevel(sampler_PerlinTex, (worldPos - wind_travel.xyz) / 12000, 0).a;
            if (near_anvil)
            {
                // The anvil: a wide flat plate just under the tops of the tallest towers (they poke through it), thin
                // out to its edges, thicker over the towers, with a ragged underside. Only in thunderstorm weather.
                float spread = storm_shapes.x;
                float bottom = 0.8 - 0.22 * smoothstep(0.3, 1.0, spread) + 0.2 * (0.68 - billow);
                float anvil = smoothstep(0.0, 0.15, spread) * 0.9 * smoothstep(0.4, 0.8, storm_params.x) *
                    smoothstep(bottom, bottom + 0.04, anvil_frac) * (1.0 - smoothstep(0.915, 0.93, anvil_frac));
                shapeGradient = max(shapeGradient, anvil);
                cell_coverage = max(cell_coverage, saturate(coverage + 0.4 * anvil));
            }
            shapeGradient *= 1.0 - dome * 0.35 * (1.0 - smoothstep(0.58, 0.78, billow));
        }
    }

    if ((1 - cell_coverage) + weather.r >= 1.0) return 0;
    worldPos.xz -= wind_direction.xy * (saturate(height_frac) * wind_shear); // Tops lean downwind.

    float3 perlin_world_pos = float3((worldPos.x - wind_travel.x) / _NoiseSize,
                                     worldPos.y * _SquishFactor / _NoiseSize, (worldPos.z - wind_travel.z) / _NoiseSize);
    float4 perlin = _PerlinTex.SampleLevel(sampler_PerlinTex, perlin_world_pos, 0);
    float detail = perlin.r * 0.625 + perlin.g * 0.25 + perlin.b * 0.125;

    //float base = saturate(perlin.a - coverage - gradient - weather.r);
    float base = perlin.a;
    base = remap(base, (1 - detail) * detail_fbm_mult, 1.0, 0.0, 1.0);
    base = base * shapeGradient;
    base = saturate(remap(base, saturate((1 - cell_coverage) + weather.r - cloud.coverage), 1.0, 0.0, 1.0));
    float scale = full_density_mult * cloud.density * densityGradient * (1.0 + 1.5 * dome);
    last_bound = base * scale;
    // The detail can only erode, so an empty base stays empty and the detail sample can be skipped.
    if (bound_only || last_bound <= 0) return max(last_bound, 0.0);
    // 0.5 is the average of the detail below, far away it fades to that so the texture isn't needed there.
    float erosion = 0.5;
    if (detail_amount > 0)
    {
        float3 low_quality_detail_rgb = _WorleyTex.SampleLevel(sampler_WorleyTex,
                                                               (worldPos - wind_travel.xyz - float3(0.0, wind_travel.w, 0.0)) / _DetailSize, 0).rgb;
        float low_quality_detail = low_quality_detail_rgb.r * 0.625 + low_quality_detail_rgb.g * 0.25 +
            low_quality_detail_rgb.b * 0.125;
        low_quality_detail = lerp(low_quality_detail, 1 - low_quality_detail, saturate(height_frac * 10));
        erosion = lerp(0.5, low_quality_detail, detail_amount);
    }
    float result = remap(base, erosion * detail_mult, 1.0, 0.0, 1.0);

    return max(result * scale, 0.0);
}

// Full detail up close, fading to the average detail far away.
float lod_detail(float cam_distance)
{
    return saturate(cam_distance * lod_fade.x + lod_fade.y);
}

// Optical depth towards the light along a widening cone: samples 1 to 5 one shadow step apart, sample 6 three steps
// long and without detail. first and last pick which samples to take, so the light volume can bake the far part
// and the raymarch only takes the near part itself.
float cone_optical_depth(float3 pos, float jitter, int first, int last, float detail_amount)
{
    float3 light_dir = normalize(-_LightDirection.xyz);
    float3 entry = pos + light_dir * jitter * shadow_step_size;
    float3 right = normalize(cross(light_dir, float3(0, 1, 0)));
    float3 up = normalize(cross(light_dir, right));
    float2 a[6] = {
        normalize(float2(-0.6, 0.94)), normalize(float2(-0.97, -0.28)), normalize(float2(0.19, -0.71)),
        normalize(float2(-0.73, -0.2)), normalize(float2(0.42, -0.38)), normalize(float2(-0.81, 0.19))
    };

    float od = 0;
    for (int i = first; i <= last; i++)
    {
        float travelled = shadow_step_size * (i < 6 ? i : 8);
        float step_size = shadow_step_size * (i < 6 ? 1 : 3);
        float2 offset = a[i - 1] * (travelled * shadow_cone_spread);
        float3 p = entry + light_dir * travelled + right * offset.x + up * offset.y;
        od += get_density(p, i < 6 ? detail_amount : 0.0) * step_size;
    }
    return od;
}

// How much of the far light cone comes from the light volume: 1 inside it, fading to 0 towards its edge.
float light_volume_weight(float3 p)
{
    if (!use_light_volume) return 0.0;
    float2 half_size = light_volume_size.xz * 0.5;
    float2 to_edge = half_size - abs(p.xz - (light_volume_origin.xz + half_size));
    // One voxel of margin for the filtering, then 2 km to fade over to the cone.
    return saturate((min(to_edge.x, to_edge.y) - light_volume_origin.w) / 2000.0);
}

// Optical depth towards the light from pos, the same as all 6 cone samples.
float light_optical_depth(float3 pos, float jitter, float detail_amount)
{
    float od = cone_optical_depth(pos, jitter, 1, 2, detail_amount);
    float volume_weight = light_volume_weight(pos);
    float far_od = 0;
    if (volume_weight > 0)
        far_od = light_volume.SampleLevel(sampler_linear_clamp, (pos - light_volume_origin.xyz) / light_volume_size.xyz, 0) * volume_weight;
    if (volume_weight < 1)
        far_od += cone_optical_depth(pos, jitter, 3, 6, detail_amount) * (1 - volume_weight);
    return od + far_od;
}

float2 get_box_bounds(float3 worldPos, float3 rayDir)
{
    float3 tl = float3((_MinBounds.x - worldPos.x) / rayDir.x, (_MinBounds.y - worldPos.y) / rayDir.y,
                       (_MinBounds.z - worldPos.z) / rayDir.z);
    float3 th = float3((_MaxBounds.x - worldPos.x) / rayDir.x, (_MaxBounds.y - worldPos.y) / rayDir.y,
                       (_MaxBounds.z - worldPos.z) / rayDir.z);

    float tc = max(min(tl.x, th.x), max(min(tl.y, th.y), min(tl.z, th.z)));
    float tf = min(max(tl.x, th.x), min(max(tl.y, th.y), max(tl.z, th.z)));

    return float2(tc, tf);
}

float2 get_sphere_bounds(float3 worldPos, float3 rayDir, float radius)
{
    float b = 2 * dot((worldPos.xyz - _SphereCenter.xyz), rayDir.xyz);
    float c = dot((worldPos.xyz - _SphereCenter.xyz), (worldPos.xyz - _SphereCenter.xyz)) - pow(radius, 2);
    float h = pow(b, 2) - 4 * c;
    if (h <= 0) return float2(-1, -1);
    float t1 = (-b - sqrt(h)) / 2;
    float t2 = (-b + sqrt(h)) / 2;
    return float2(t1, t2);
}

float get_bounds_intersect(float3 pos, float3 rayDir)
{
    float2 sphere1intersect = get_sphere_bounds(pos, rayDir, _SphereMinRadius);
    float2 sphere2intersect = get_sphere_bounds(pos, rayDir, _SphereMaxRadius);
    float2 boxIntersect = get_box_bounds(pos, rayDir);


    float tEnter = max(0.0, sphere2intersect.x);
    float tExit = sphere2intersect.y;

    // The sphere is behind the player.
    if (tExit <= tEnter) return -1;

    if (combine_bounds)
    {
        tEnter = max(tEnter, boxIntersect.x);
        tExit = min(tExit, boxIntersect.y);
        if (tExit <= tEnter) return -1;
    }

    float2 seg0 = float2(tEnter, tExit);


    float innerA = sphere1intersect.x;
    float innerB = sphere1intersect.y;
    bool innerHits = innerB > 0 && innerA < innerB;

    if (innerHits)
    {
        innerA = max(innerA, tEnter);
        innerB = min(innerB, tExit);
        if (innerA < innerB)
        {
            bool clipsStart = innerA <= tEnter;
            bool clipsEnd = innerB >= tExit;
            if (clipsStart && clipsEnd) return -1; // The box is fully inside the smaller sphere.
            else if (clipsStart) seg0.x = innerB;
        }
    }

    return seg0.x;
}

float3 calculateWorldPos(float2 uv, float depth, float4x4 inv_vp)
{
    float4 ndc = float4(uv * 2.0 - 1.0, depth, 1.0);
    float4 worldPos = mul(inv_vp, ndc);
    return worldPos.xyz / worldPos.w;
}

// Sun (or moon at night) light for the clouds.
float3 cloud_light_color()
{
    float sun_elevation = -_LightDirection.y;
    float t = smoothstep(0.0, 0.25, sun_elevation);
    float sun_up = smoothstep(-0.1, 0.05, sun_elevation);
    // x3 keeps Light Contribution about as bright as the old beer-powder lighting.
    return lerp(light_contribution_sunset.rgb, light_contribution_day.rgb, t) * _MainLightColor.rgb * sun_up * 3.0;
}

// Sky light for the clouds.
float3 cloud_ambient_color()
{
    float sun_up = smoothstep(-0.1, 0.05, -_LightDirection.y);
    return lerp(fog_base_color_night.rgb, fog_base_color_day.rgb, sun_up);
}

// How much light scatters towards the camera through shadow_od of cloud.
// Multiple scattering (Wrenninge 2013): every octave goes deeper, scatters less and more evenly.
float scattered_light(float shadow_od, float cos_theta)
{
    float sun_light = 0;
    float extinction = 1, scattering = 1, eccentricity = 1;
    for (int o = 0; o < 3; o++)
    {
        sun_light += scattering * exp(-shadow_od * extinction) *
            dual_lobe_phase(_LightScattering * eccentricity, back_scattering * eccentricity, cos_theta);
        extinction *= 0.5;
        scattering *= 0.5;
        eccentricity *= 0.5;
    }
    return sun_light;
}

// Step length at a distance from the camera: Step Length up close, growing with the distance after that. Far away one
// pixel covers more and the detail has faded out, so long steps there lose nothing, and every ray gets about the same
// detail per pixel whatever its length.
float cloud_step_length(float cam_distance)
{
    return max(step_length, cam_distance * step_growth);
}

// steps_left: how many samples this pixel may still take, shared by both parts of a split ray.
float4 raymarch(float3 startPoint, float3 endPoint, float3 camPoint, float3 fogCol, float viewLength, float transmittance,
                float2 id, inout float2 depth_acc, inout int steps_left)
{
    float3 light_contribution = cloud_light_color();
    float3 ambient_color = cloud_ambient_color();
    float jitter = ign(id);
    float3 rayDir = normalize(endPoint - startPoint);
    float startDist = distance(startPoint, camPoint);
    if (startDist > viewLength) return float4(fogCol, transmittance);
    // Stop where the scene depth is, so terrain in front of the clouds hides them.
    float maxDist = min(distance(startPoint, endPoint), viewLength - startDist);

    float cos_theta = dot(rayDir, -_LightDirection.xyz);
    float3 fogColor = fogCol;
    float3 haze_color = procedural_sky(rayDir);

    // Empty space skipping: while nothing is around, only every 3rd step gets sampled (a big step), and only for the
    // base shape (no detail, no light). When that finds something the march goes back to just after the last empty
    // sample and takes normal steps again, until 4 samples in a row have no base shape either. The big steps start
    // 0 to 2 normal steps in, at random, otherwise the same 2 of every 3 steps would never be checked.
    uint2 cell = (uint2)id;
    uint hash = (cell.x * 73856093u) ^ (cell.y * 19349663u);
    hash ^= hash >> 13;
    hash *= 0x5bd1e995u;
    hash ^= hash >> 15;
    int coarse_offset = (int)(hash % 3u);
    bool coarse = empty_space_skipping;
    // The march goes along startPoint to endPoint, which lies on the camera ray, so the camera distance is
    // startDist + travelled.
    float first_step = cloud_step_length(startDist);
    float travelled = (jitter + (coarse ? coarse_offset : 0)) * first_step;
    float last_empty = (jitter - 1.0) * first_step;
    int empty_samples = 0;

    // Stops at 1% transmittance, what is left behind that can't be seen anyway.
    while (steps_left > 0 && transmittance > 0.01 && travelled < maxDist)
    {
        steps_left--;
        float3 worldPos = startPoint + rayDir * travelled;
        float cam_distance = startDist + travelled;
        // Never shorter than what still reaches the end of the segment with the samples left, so a ray that runs
        // out of samples doesn't stop short of it (the clouds ended in a ring).
        float step_size = max(cloud_step_length(cam_distance), (maxDist - travelled) / max(steps_left, 1));
        float detail_amount = lod_detail(cam_distance);
        float density = get_density(worldPos, detail_amount, coarse);
        if (coarse)
        {
            if (density > 0)
            {
                coarse = false;
                empty_samples = 0;
                travelled = last_empty + cloud_step_length(startDist + last_empty);
            }
            else
            {
                last_empty = travelled;
                travelled += 3.0 * step_size;
            }
            continue;
        }
        if (density <= 0)
        {
            last_empty = travelled;
            travelled += step_size;
            empty_samples = last_bound > 0 ? 0 : empty_samples + 1;
            if (empty_space_skipping && empty_samples >= 4)
            {
                coarse = true;
                empty_samples = 0;
            }
            continue;
        }
        empty_samples = 0;
        float height_frac = saturate(last_height_frac);
        float shadow_od = light_optical_depth(worldPos, jitter, detail_amount);
        float sun_light = scattered_light(shadow_od, cos_theta);
        // Powder darkens edges when the sun is behind you, fades out when looking towards the sun.
        float powder = lerp(1.0, 1.0 - exp(-2.0 * shadow_od), powder_strength * saturate(0.5 - 0.5 * cos_theta));
        float3 ambient = ambient_color * lerp(ambient_bottom, 1.0, height_frac);
        // The air in front of far samples gives them the sky's colour, so the horizon fills up with hazy clouds
        // instead of turning see-through (which showed the dark ground from above the clouds).
        float haze = 1.0 - exp(-cam_distance / max(horizon_fade, 1.0));
        // Fully hazed by the draw distance, so seen from above the clouds don't end in a line there.
        haze = max(haze, smoothstep(0.6 * _SphereMaxRadius, _SphereMaxRadius, cam_distance));
        float step_opacity = 1.0 - exp(-density * step_size);
        // Average distance weighted by how much each step shows up in the final pixel.
        depth_acc += float2(cam_distance, 1.0) * (transmittance * step_opacity);
        // Energy conserving integration (Hillaire 2015), looks the same no matter the step size.
        fogColor.rgb += transmittance * step_opacity * lerp(light_contribution * sun_light * powder + ambient, haze_color, haze);
        transmittance *= 1.0 - step_opacity;
        travelled += step_size;
    }
    return float4(fogColor.rgb, transmittance);
}

// Marches the part of the view ray inside the outer sphere (and the box when combined), minus the inner sphere,
// which can split it in two. res: premultiplied colour so far and the transmittance.
float4 march_cloud_layer(float3 entryPos, float3 rayDir, float viewLength, float2 jitter_id, float4 res,
                         inout float2 depth_acc)
{
    if (!_UseBoundingSphere) return res;

    float2 sphere1intersect = get_sphere_bounds(entryPos, rayDir, _SphereMinRadius);
    float2 sphere2intersect = get_sphere_bounds(entryPos, rayDir, _SphereMaxRadius);
    float2 boxIntersect = get_box_bounds(entryPos, rayDir);

    float tEnter = max(0.0, sphere2intersect.x);
    float tExit = sphere2intersect.y;

    // The sphere is behind the player.
    if (tExit <= tEnter) return res;

    if (combine_bounds)
    {
        tEnter = max(tEnter, boxIntersect.x);
        tExit = min(tExit, boxIntersect.y);
        if (tExit <= tEnter) return res;
    }

    float2 seg0 = float2(tEnter, tExit);
    float2 seg1 = float2(0.0, 0.0);
    bool split = false;

    float innerA = sphere1intersect.x;
    float innerB = sphere1intersect.y;
    bool innerHits = innerB > 0 && innerA < innerB;

    if (innerHits)
    {
        innerA = max(innerA, tEnter);
        innerB = min(innerB, tExit);
        if (innerA < innerB)
        {
            bool clipsStart = innerA <= tEnter;
            bool clipsEnd = innerB >= tExit;
            if (clipsStart && clipsEnd) return res; // The box is fully inside the smaller sphere.
            else if (clipsStart) seg0.x = innerB;
            else if (clipsEnd) seg0.y = innerA;
            else
            {
                seg0.y = innerA;
                seg1 = float2(innerB, tExit);
                split = true;
            }
        }
    }

    // A split ray gives its first part half of the samples, the second part gets the rest.
    int first_budget = split ? max(max_steps / 2, 1) : max_steps;
    int steps_left = first_budget;
    float3 a0 = entryPos + rayDir * seg0.x;
    float3 b0 = entryPos + rayDir * seg0.y;
    res = raymarch(a0, b0, entryPos, res.rgb, viewLength, res.a, jitter_id, depth_acc, steps_left);
    if (split)
    {
        steps_left += max_steps - first_budget;
        float3 a1 = entryPos + rayDir * seg1.x;
        float3 b1 = entryPos + rayDir * seg1.y;
        res = raymarch(a1, b1, entryPos, res.rgb, viewLength, res.a, jitter_id, depth_acc, steps_left);
    }
    return res;
}

// Thin, high ice clouds: a flat sheet at cirrus height streaked along the wind, one sample per pixel. Returns the
// premultiplied colour and the opacity, and how far away it is for the reprojection.
float4 cirrus(float3 cam, float3 ray_dir, float view_length, out float distance_to)
{
    distance_to = 0;
    if (cirrus_params.w <= 0) return float4(0.0, 0.0, 0.0, 0.0);
    float t = (cirrus_params.x - cam.y) / ray_dir.y;
    // Behind the camera, behind terrain, or so far out that it has faded away anyway.
    if (!(t > 0) || t > min(view_length, 300000.0)) return float4(0.0, 0.0, 0.0, 0.0);
    distance_to = t;

    // Moves with the same wind as the other clouds, so the reprojection follows it.
    float2 p = cam.xz + ray_dir.xz * t - wind_travel.xz;
    float2 along = wind_direction.xy;
    float2 across = float2(-along.y, along.x);
    // Pick the mips from how much of the sheet one pixel covers: t * pixel_angle sideways and stretched by 1 / y
    // along the view towards the horizon. The streaks are squashed across the wind, so both directions get
    // measured in their texels and the bigger one wins (no aliasing, a bit of blur).
    uint map_width, map_height;
    weather_map.GetDimensions(map_width, map_height);
    float side_extent = t * pixel_angle * map_width;
    float depth_extent = side_extent / max(abs(ray_dir.y), 0.01);
    float2 view_flat = ray_dir.xz / max(length(ray_dir.xz), 1e-4);
    float view_along = dot(view_flat, along);
    float view_across = dot(view_flat, across);
    float depth_texels = length(float2(view_along / cirrus_scale.x, view_across / cirrus_scale.y)) * depth_extent;
    float side_texels = length(float2(view_across / cirrus_scale.x, view_along / cirrus_scale.y)) * side_extent;
    float streak_lod = log2(max(max(depth_texels, side_texels), 1.0));
    float patch_lod = log2(max(depth_extent / cirrus_scale.z, 1.0));

    // The wisps are the a channel stretched along the wind. A second, smaller and slightly turned copy hides the tiling.
    float2 streak_uv = float2(dot(p, along) / cirrus_scale.x, dot(p, across) / cirrus_scale.y);
    float2 turned = float2(dot(streak_uv, float2(0.99, 0.14)), dot(streak_uv, float2(-0.14, 0.99)));
    float wisps = weather_map.SampleLevel(sampler_weather_map, streak_uv, streak_lod).a;
    wisps *= weather_map.SampleLevel(sampler_weather_map, turned * 1.61 + 0.37, streak_lod + 0.7).a;
    float patches = weather_map.SampleLevel(sampler_weather_map, p / cirrus_scale.z, patch_lod).b;

    float density = saturate(remap(patches, 1.0 - cirrus_params.y, 1.0, 0.0, 1.0)) * saturate(wisps * 3.0);
    float opacity = density * cirrus_params.z;
    // Thin enough that nothing shadows it, so it gets the light the cloud layer gets at its edges.
    float cos_theta = dot(ray_dir, -_LightDirection.xyz);
    float3 color = cloud_light_color() * scattered_light(0.0, cos_theta) + cloud_ambient_color();
    // Same air as for the cloud layer between the camera and the sheet, fully hazed by its 300 km edge.
    color = lerp(color, procedural_sky(ray_dir), max(1.0 - exp(-t / max(horizon_fade, 1.0)), smoothstep(180000.0, 300000.0, t)));
    return float4(color * opacity, opacity);
}

// Step lengths of the rain curtains in meters: big through dry air, small under the storm cells. Both grow with the
// distance, far away a pixel covers more anyway.
float rain_big_step(float t)
{
    return max(1200.0, t * 0.06);
}

float rain_small_step(float t)
{
    return max(250.0, t * 0.02);
}

// How much rain is in the air at p (rain_amount in CloudRain.hlsl), in strands. in_cell says if p is under an active
// cell at all, the curtains take small steps there. step_length filters the strands, so neighbouring pixels agree on
// them and they come out as streaks instead of noise.
float rain_density(float3 p, float step_length, float map_width, out bool in_cell)
{
    // Rain this far below the cloud base left it a bit downwind (the wind is slower lower down), so the columns lean
    // like the towers do.
    float2 xz = p.xz + wind_direction.xy * ((rain_base - p.y) * 0.35) - wind_travel.xz;
    float4 weather = weather_map.SampleLevel(sampler_weather_map, xz / 128000, 0);
    // The light rain comes in patches. The a channel (cirrus wisps) is evenly spread noise.
    float patches = weather_map.SampleLevel(sampler_weather_map, xz / 24000 + 0.5, 0).a;
    float rain = rain_amount(weather, storm_cell(xz), patches, rain_params, 0.15, in_cell);
    if (rain <= 0) return 0.0;
    float strands = weather_map.SampleLevel(sampler_weather_map, xz / 4000, log2(max(step_length * map_width / 4000, 1.0))).a;
    return rain * (0.1 + 1.8 * strands);
}

// Rain between the ground and the cloud base, marched by step length: big steps through dry air, and when one lands
// under a storm cell the march goes back to where the last step ended and walks the cell in small steps, until two
// samples in a row are out of it. Below the cloud base the curtains start a few km out, the rain right around the
// camera is the streaks in the composite. Returns the premultiplied colour and the opacity, and the average distance
// for the reprojection.
float4 rain_curtains(float3 cam, float3 ray, float view_length, float jitter, out float mean_distance)
{
    mean_distance = 0;
    if (rain_params.x <= 0) return float4(0.0, 0.0, 0.0, 0.0);

    // Where the ray is between the ground and the cloud base, no further than 60 km.
    float t0 = 0, t1 = 0;
    if (abs(ray.y) < 1e-5)
    {
        if (cam.y > 0 && cam.y < rain_base) t1 = 60000.0;
    }
    else
    {
        float to_ground = -cam.y / ray.y;
        float to_base = (rain_base - cam.y) / ray.y;
        t0 = max(min(to_ground, to_base), 0.0);
        t1 = max(to_ground, to_base);
    }
    t1 = min(t1, min(view_length, 60000.0));
    if (t1 <= t0) return float4(0.0, 0.0, 0.0, 0.0);

    // Lit mostly by the sky, rain curtains look dark grey against it.
    float3 rain_color = cloud_ambient_color() * 0.7 + cloud_light_color() * 0.02;
    float3 haze_color = procedural_sky(ray);
    uint map_width, map_height;
    weather_map.GetDimensions(map_width, map_height);
    // Below the cloud base the curtains fade in from 2 to 5 km out (sideways, so the same in every direction), and
    // there is no point marching the part before that.
    float below = saturate((rain_base - cam.y) / 300.0);
    float horizontal = length(ray.xz);
    if (below >= 1.0) t0 = max(t0, 2000.0 / max(horizontal, 1e-4));
    if (t1 <= t0) return float4(0.0, 0.0, 0.0, 0.0);
    float3 color = float3(0.0, 0.0, 0.0);
    float transmittance = 1.0;
    float2 distance_acc = float2(0.0, 0.0);
    // prev: where the part added so far ends, t: the next sample.
    float prev = t0;
    float t = t0 + jitter * rain_big_step(t0);
    bool fine = false;
    // Where the big step found the cell. Fine mode goes on at least that far.
    float hit = t0;
    int dry = 0;
    [loop]
    for (int i = 0; i < 96 && prev < t1 && transmittance > 0.01; i++)
    {
        float step_length = fine ? rain_small_step(prev) : rain_big_step(prev);
        float ts = min(t, t1);
        bool in_cell;
        float density = rain_density(cam + ray * ts, step_length, (float)map_width, in_cell);
        if (!fine && in_cell)
        {
            fine = true;
            hit = ts;
            t = prev + jitter * rain_small_step(prev);
            continue;
        }
        float end = fine ? min(prev + step_length, t1) : ts;
        float fade = (1.0 - below * (1.0 - smoothstep(2000.0, 5000.0, horizontal * ts))) *
            (1.0 - smoothstep(45000.0, 60000.0, ts));
        // The heaviest rain lets you see about 3.5 km.
        float opacity = (1.0 - exp(-density / 3500.0 * (end - prev))) * fade;
        float haze = 1.0 - exp(-ts / max(horizon_fade, 1.0));
        color += transmittance * opacity * lerp(rain_color, haze_color, haze);
        distance_acc += float2(ts, 1.0) * (transmittance * opacity);
        transmittance *= 1.0 - opacity;
        prev = end;
        if (fine)
        {
            dry = in_cell ? 0 : dry + 1;
            if (dry >= 2 && prev > hit)
            {
                fine = false;
                dry = 0;
            }
        }
        t = prev + (fine ? jitter * rain_small_step(prev) : rain_big_step(prev));
    }
    mean_distance = distance_acc.y > 1e-4 ? distance_acc.x / distance_acc.y : 0.0;
    return float4(color, 1.0 - transmittance);
}

// Puts a layer (premultiplied colour, opacity) behind what res already holds.
void add_behind(inout float4 res, inout float2 depth_acc, float4 layer, float layer_distance)
{
    depth_acc += float2(layer_distance, 1.0) * (res.a * layer.a);
    res.rgb += res.a * layer.rgb;
    res.a *= 1.0 - layer.a;
}

[numthreads(8,8,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    // The dispatch is rounded up, so threads past the edge have nothing to do.
    if (any(id.xy >= (uint2)cloud_size.zw)) return;
    Result[id.xy] = float4(0.0, 0.0, 0.0, 0.0);
    ResultDepth[id.xy] = 0.0;

    // With temporal upscaling each thread renders one pixel of a 2x2 or 4x4 block, a different one every frame.
    uint2 pixel = id.xy * upscale_block() + upscale_offset();
    if (any(pixel >= (uint2)cloud_size.xy)) return;
    float2 uv = (pixel + 0.5) / cloud_size.xy;
    // Moving the jitter every frame lets the Resolve kernel average the noise away (Jimenez 2014).
    float2 jitter_id = pixel + (frame_index & 63) * 5.588238;

    float depth = DepthTex.SampleLevel(sampler_DepthTex, uv, 0).r;
    float3 worldPos = calculateWorldPos(uv, depth, _InvVP);
    float3 entryPos = _CamPos.xyz;
    float3 viewDir = worldPos - entryPos;
    float viewLength = abs(depth - sky_depth) < 1e-7 ? _MaxDistance : length(viewDir);
    float3 rayDir = normalize(viewDir);


    // rgb: premultiplied colour, a: transmittance. Front to back: the cirrus is above the cloud layer and the rain
    // below it, so which comes first depends on where the camera is.
    float4 res = float4(0.0, 0.0, 0.0, 1.0);
    float2 depth_acc = float2(0.0, 0.0);
    float cirrus_distance, rain_distance;
    float4 cirrus_layer = cirrus(entryPos, rayDir, viewLength, cirrus_distance);
    float4 rain_layer = rain_curtains(entryPos, rayDir, viewLength, ign(jitter_id), rain_distance);
    bool above_cirrus = entryPos.y > cirrus_params.x;
    bool below_base = entryPos.y < rain_base;
    if (above_cirrus) add_behind(res, depth_acc, cirrus_layer, cirrus_distance);
    if (below_base) add_behind(res, depth_acc, rain_layer, rain_distance);
    res = march_cloud_layer(entryPos, rayDir, viewLength, jitter_id, res, depth_acc);
    if (!below_base) add_behind(res, depth_acc, rain_layer, rain_distance);
    if (!above_cirrus) add_behind(res, depth_acc, cirrus_layer, cirrus_distance);
    Result[id.xy] = float4(res.rgb, 1.0 - saturate((res.a <= 0.01 ? 0 : res.a)));
    ResultDepth[id.xy] = depth_acc.y > 0.001 ? depth_acc.x / depth_acc.y : 0.0;
}

// Draws the storm clouds' shapes into anvil_map, over the storm map's 128 km tile (12x12 grid cells). They reach past
// their grid cell, so neighbouring ones overlap, which the cells in the storm map can't. Runs every frame, the weather
// and the wind change it.
// A storm grows with its maturity (0 for a cell that just became active, 1 for the most developed one): its towers get
// wider (1.2 to 2.2 times the cell's radius) and taller, from a congestus at 0.3 to a cumulonimbus, each storm to its own
// height. Most have a flanking line of two smaller, lower towers stepping down from the main one, so a storm is a
// cluster with uneven tops instead of one round drum. The anvil comes on as the storm gets tall: an ellipse 2.5 times
// the cell's radius, 1.5 times as long along the wind and moved downwind.
[numthreads(8,8,1)]
void AnvilMap(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    anvil_map_out.GetDimensions(width, height);
    if (any(id.xy >= uint2(width, height))) return;
    float2 p = (id.xy + 0.5) / float2(width, height) * 12.0;
    int2 grid = (int2)floor(p);
    float2 along = anvil_params.zw;
    float2 across = float2(-along.y, along.x);
    float4 result = float4(0.0, 0.0, 0.0, 0.0);
    float share = anvil_params.x;
    float towers = anvil_params.y;
    // The anvil height is an average weighted towards the nearest anvils, so it doesn't jump where two anvils of
    // different heights meet, and it is still set a bit past their edge, so their rims don't sag in the filtering.
    float height_sum = 0.0;
    float weight_sum = 0.0;
    // A flanking tower reaches at most (1.35 + 0.42) * 2.2 * 0.45 grid cells and an anvil 2.5 * 0.45 * 1.5 + 0.3 * 1.125
    // (both under 2), so the 5x5 cells around are enough.
    for (int dy = -2; dy <= 2; dy++)
    {
        for (int dx = -2; dx <= 2; dx++)
        {
            int2 c = grid + int2(dx, dy);
            // c is at least -2, so + 24 keeps it positive for the unsigned modulo.
            int2 wrapped = (int2)((uint2)(c + 24) % 12u);
            int index = wrapped.y * 12 + wrapped.x;
            float4 cell = storm_cells[index];
            float4 extra = storm_cells_extra[index];
            float activity = saturate((share - cell.w) * 8.0);
            float maturity = saturate((share - cell.w) / max(share, 1e-3));
            float storm_height = towers * activity * (0.3 + 0.7 * smoothstep(0.0, 0.8, maturity)) * (0.75 + 0.25 * extra.x);
            float radius = cell.z * (1.2 + maturity);
            float2 centre = cell.xy + (float2)(c - wrapped);
            float angle = extra.y * 6.2831853;
            float2 flank = float2(cos(angle), sin(angle));
            int tower_count = extra.z < 0.7 ? 3 : 1;
            for (int t = 0; t < tower_count; t++)
            {
                // The main tower, then the flanking ones, smaller and lower the further out they are.
                float offset = t == 0 ? 0.0 : (t == 1 ? 0.75 : 1.35);
                float size = t == 0 ? 1.0 : (t == 1 ? 0.6 : 0.42);
                float lower = t == 0 ? 1.0 : (t == 1 ? 0.75 : 0.5);
                float footprint = saturate(1.0 - length(p - centre - flank * (radius * offset)) / (radius * size)) * activity;
                // Rises at the rim and stays high over the inner half: wide bodies with rounded shoulders.
                float rise = sqrt(saturate(footprint / 0.5));
                result.y = max(result.y, rise * towers);
                result.z = max(result.z, rise * storm_height * lower);
            }
            float r = cell.z * 2.5;
            float2 q = p - (centre + along * (r * 0.3));
            float d = length(float2(dot(q, along) / (r * 1.5), dot(q, across) / r));
            float developed = activity * smoothstep(0.15, 0.4, maturity);
            result.x = max(result.x, saturate(1.0 - d) * developed);
            float weight = pow(saturate(1.3 - d), 4.0) * developed;
            height_sum += weight * storm_height;
            weight_sum += weight;
        }
    }
    result.w = weight_sum > 1e-5 ? height_sum / weight_sum : 0.0;
    anvil_map_out[id.xy] = result;
}

// Builds the optical depth volume for the far part of the light cone (samples 3 to 6), from every voxel centre
// with the average jitter. It gets rebuilt every frame, so the wind and the day night cycle never make it stale.
[numthreads(4,4,4)]
void LightVolume(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)light_volume_res.xyz)) return;
    float3 voxel_pos = light_volume_origin.xyz + ((float3)id + 0.5) * light_volume_size.xyz / light_volume_res.xyz;
    light_volume_out[id] = cone_optical_depth(voxel_pos, 0.5, 3, 6, lod_detail(distance(voxel_pos, _CamPos.xyz)));
}

// Bicubic (Catmull-Rom) sample made from 9 bilinear taps. The history gets resampled every frame,
// with plain bilinear it would slowly blur.
float4 sample_catmull_rom(Texture2D<float4> tex, float2 uv, float2 size)
{
    float2 sample_pos = uv * size;
    float2 tex_pos1 = floor(sample_pos - 0.5) + 0.5;
    float2 f = sample_pos - tex_pos1;

    float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    float2 w3 = f * f * (-0.5 + 0.5 * f);
    float2 w12 = w1 + w2;

    float2 tex_pos0 = (tex_pos1 - 1.0) / size;
    float2 tex_pos3 = (tex_pos1 + 2.0) / size;
    float2 tex_pos12 = (tex_pos1 + w2 / w12) / size;

    float4 result = 0;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos0.x, tex_pos0.y), 0) * w0.x * w0.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos12.x, tex_pos0.y), 0) * w12.x * w0.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos3.x, tex_pos0.y), 0) * w3.x * w0.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos0.x, tex_pos12.y), 0) * w0.x * w12.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos12.x, tex_pos12.y), 0) * w12.x * w12.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos3.x, tex_pos12.y), 0) * w3.x * w12.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos0.x, tex_pos3.y), 0) * w0.x * w3.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos12.x, tex_pos3.y), 0) * w12.x * w3.y;
    result += tex.SampleLevel(sampler_linear_clamp, float2(tex_pos3.x, tex_pos3.y), 0) * w3.x * w3.y;
    return result;
}

// Blends this frame's raymarch into last frame's result. Smooths out the jitter noise and, with temporal
// upscaling, builds the full resolution image from the sparse samples over several frames.
[numthreads(8,8,1)]
void Resolve(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= (uint2)cloud_size.xy)) return;

    int2 current_max = (int2)cloud_size.zw - 1;
    bool upscaling = upscale_block() > 1;
    int2 center_id = min((int2)(id.xy / upscale_block()), current_max);
    // Where this frame's samples sit: every pixel, or one per block at this frame's offset.
    float sample_spacing = (float)upscale_block();
    float2 sample_offset = (float2)upscale_offset();
    // Gaussian radius 0.8 px for 4x4 and 0.6 px for 2x2 (as 1 / 2r^2), picked by simulating the upsampler on a real screenshot.
    float falloff = upscale_block() >= 4 ? 0.78125 : 1.388889;

    // Look at this frame's samples around the pixel: their range clamps the history (stops ghosting),
    // their distance weighted average is the new value when upscaling, and their depth drives the reprojection.
    float4 center = current_frame[center_id];
    float4 neighbour_min = center;
    float4 neighbour_max = center;
    float4 estimate = float4(0.0, 0.0, 0.0, 0.0);
    float estimate_weight = 0.0;
    float depth_sum = 0.0;
    float depth_weight = 0.0;
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            int2 sample_id = clamp(center_id + int2(x, y), 0, current_max);
            float4 neighbour = current_frame[sample_id];
            float neighbour_depth = current_depth[sample_id];
            neighbour_min = min(neighbour_min, neighbour);
            neighbour_max = max(neighbour_max, neighbour);

            float2 to_sample = (float2)sample_id * sample_spacing + sample_offset - (float2)id.xy;
            float weight = exp(-dot(to_sample, to_sample) * falloff);
            estimate += neighbour * weight;
            estimate_weight += weight;
            if (neighbour_depth > 0.0)
            {
                depth_sum += neighbour_depth * weight;
                depth_weight += weight;
            }
        }
    }

    // Without upscaling every pixel has its own fresh sample. With upscaling a pixel only gets a close
    // sample every few frames, so it takes a bigger share of whatever is near it this frame.
    float4 current = upscaling ? estimate / estimate_weight : center;
    float blend = upscaling ? saturate(saturate(temporal_blend * 5.0) * estimate_weight) : temporal_blend;

    // Where were these clouds last frame? Uses the raymarched cloud distance, so flying around reprojects
    // correctly. Pixels without clouds nearby fall back to the cloud layer entry (any distance works for rotation).
    float2 uv = (id.xy + 0.5) / cloud_size.xy;
    float3 ray_dir = normalize(calculateWorldPos(uv, 0.5, _InvVP) - _CamPos.xyz);
    float cloud_distance = depth_weight > 0.0 ? depth_sum / depth_weight
                                              : max(get_bounds_intersect(_CamPos.xyz, ray_dir), 1000.0);
    float3 cloud_pos = _CamPos.xyz + ray_dir * cloud_distance + wind_offset.xyz;
    float4 prev_clip = mul(prev_vp, float4(cloud_pos, 1.0));
    float2 prev_uv = prev_clip.xy / prev_clip.w * 0.5 + 0.5;
    bool on_screen = prev_clip.w > 0 && all(prev_uv >= 0) && all(prev_uv <= 1);

    if (!history_valid || !on_screen) blend = 1.0;

    // Selected instead of lerped so garbage in a freshly created history texture can't leak through.
    if (blend >= 1.0)
    {
        Result[id.xy] = current;
        return;
    }
    float4 history = clamp(sample_catmull_rom(rendertexture_old, prev_uv, cloud_size.xy), neighbour_min, neighbour_max);
    Result[id.xy] = lerp(history, current, blend);
}

[numthreads(8,8,1)]
void CloudsShadows(uint3 id : SV_DispatchThreadID)
{
    float2 worldXZ = shadow_center.xy + ((id.xy + 0.5) / shadow_resolution - 0.5) * shadow_world_size;
    float3 shadow_start_pos = float3(worldXZ.x, _MinBounds.y, worldXZ.y);
    float3 rayDir = normalize(-_LightDirection.xyz);

    float2 box_intersect = get_box_bounds(shadow_start_pos, rayDir);

    float3 endPoint = shadow_start_pos + rayDir * box_intersect.y;

    int steps = 0;
    float optical_depth = 0.0;

    float step_size = distance(shadow_start_pos, endPoint) / shadow_steps;

    while (steps < shadow_steps)
    {
        float3 p = shadow_start_pos + rayDir * step_size * (steps + 0.5);
        optical_depth += get_density(p, 0.0) * step_size;
        steps++;
    }

    //shadowRT[id.xy] = frac(worldXZ.x * 0.001);
    shadowRT[id.xy] = exp(-optical_depth);
    //shadowRT[id.xy] = (id.x + 0.5) / shadow_resolution;
}
