// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel GenPerlin
#pragma kernel GenWorley
#pragma kernel gen_weather

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture3D<float4> PerlinTex;
RWTexture3D<float4> WorleyTex;
RWTexture2D<float4> weather_map;

RWStructuredBuffer<int> min_max_buffer;

float4 perlin_worley_perlin_floats;
float4 perlin_worley_worley_floats;
float4 perlin_worley_1_floats;
float4 perlin_worley_2_floats;
float4 perlin_worley_3_floats;
float4 weather_floats;

float w_worley_1_base_frequency_global;
float w_worley_2_base_frequency_global;
float w_worley_3_base_frequency_global;

struct noise_parameters
{
    float frequency;
    float gain;
    float lacunarity;
    int octaves;
};

noise_parameters Unpack(float4 v)
{
    noise_parameters p;
    p.frequency = v.x;
    p.gain = v.y;
    p.lacunarity = v.z;
    p.octaves = (int)round(v.w);
    return p;
}

uint3 pcg3d(uint3 v)
{
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z;
    v.y += v.z * v.x;
    v.z += v.x * v.y;
    return v;
}


float3 hash33(int3 p)
{
    uint3 h = pcg3d((uint3)p);
    return float3(h) * (1.0 / 4294967295.0) * 2.0 - 1.0;
}

float Worley(float3 pos, int size){
    
    float dist = -1;
    
    pos *= size;
    float3 gridPos = floor(pos);
    
    for (int x = -1; x <= 1; x++)
    {
        for (int y = -1; y <= 1; y++)
        {
            for (int z = -1; z <= 1; z++)
            {
                float3 currentPoint = gridPos + float3(x, y, z);
                float3 wrapped = fmod(currentPoint + size, size);
                currentPoint += (hash33((int3)wrapped) + 1.0) / 2.0;
                float d = distance(pos, currentPoint);
                if (dist == -1.0 || d < dist)
                {
                    dist = d;
                }
            }
        }
    }
    return dist;
}

float smoothstep(float x)
{
    return 6 * pow(x, 5) - 15 * pow(x, 4) + 10 * pow(x, 3);
}

float customLerp(float t, float a, float b)
{
    return a + smoothstep(frac(t)) * (b - a);
}

float Perlin(float3 pos, int freq)
{
    float3 p = pos * freq;
    float3 pmin = floor(p);
    float3 pmax = pmin + 1;
    
    float3 vectors[8], hVectors[8];
    float vectorDotValues[8];
    
    vectors[0] = float3(pmin.x,pmin.y,pmin.z); //000
    vectors[1] = float3(pmin.x,pmin.y,pmax.z); //001
    vectors[2] = float3(pmin.x,pmax.y,pmin.z); //010
    vectors[3] = float3(pmin.x,pmax.y,pmax.z); //011
    vectors[4] = float3(pmax.x,pmin.y,pmin.z); //100
    vectors[5] = float3(pmax.x,pmin.y,pmax.z); //101
    vectors[6] = float3(pmax.x,pmax.y,pmin.z); //110
    vectors[7] = float3(pmax.x,pmax.y,pmax.z); //111
    
    for (int i = 0; i < 8; i++)
    {
        hVectors[i] = normalize(hash33((int3)vectors[i] % freq));
        float3 cVector = p - vectors[i];
        vectorDotValues[i] = dot(hVectors[i], cVector);
    }
    
    float x0, x1, x2, x3, y0, y1, value;
    x0 = customLerp(p.x, vectorDotValues[0], vectorDotValues[4]);
    x1 = customLerp(p.x, vectorDotValues[2], vectorDotValues[6]);
    x2 = customLerp(p.x, vectorDotValues[1], vectorDotValues[5]);
    x3 = customLerp(p.x, vectorDotValues[3], vectorDotValues[7]);
    
    y0 = customLerp(p.y, x0, x1);
    y1 = customLerp(p.y, x2, x3);
    
    value = customLerp(p.z, y0, y1);
    
    
    
    return value;
}

float remap(float v, float inMin, float inMax, float outMin, float outMax)
{
    return outMin + (v - inMin) / (inMax - inMin) * (outMax - outMin);
}

float perlin_fbm(float3 pos, noise_parameters n)
{
    float result = 0;
    
    float sum = 0;
    float amp = 1;
    float frequency = n.frequency;
    
    for (int x = 0; x < n.octaves; x++)
    {
        if (frequency > 128) break; // Above half the 256 texture resolution an octave only adds aliasing.
        result += remap(Perlin(pos, (int)round(frequency)), -0.75, 0.75, 0, 1) * amp;
        sum += amp;
        
        amp *= n.gain;
        frequency *= n.lacunarity;
    }
    
    result /= sum;
    
    return result;
}

float worley_fbm(float3 pos, noise_parameters n, float cell_radius)
{
    float result = 1;
    
    float sum = 0;
    float amp = 1;
    float frequency = n.frequency;
    
    for (int x = 0; x < n.octaves; x++)
    {
        if (frequency / cell_radius > 128) break; // Same aliasing limit as perlin_fbm.
        result *= (1 - Worley(pos, ((int)round(frequency)) / cell_radius)  * amp);
        sum += amp;
        
        amp *= n.gain;
        frequency *= n.lacunarity;
    }
    
    return saturate(result);
}

[numthreads(8,8,8)]
void GenPerlin (uint3 id : SV_DispatchThreadID)
{
    float3 uvw = (id.xyz + 0.5) / 256;

    
    //float perlin = (Perlin(uvw, pw_perlin1_size) * pw_perlin1_weight + Perlin(uvw, pw_perlin2_size) * pw_perlin2_weight + Perlin(uvw, pw_perlin3_size) * pw_perlin3_weight) / (pw_perlin1_weight + pw_perlin2_weight + pw_perlin3_weight);
    
    
    float pw_perlin = perlin_fbm(uvw, Unpack(perlin_worley_perlin_floats));
    
    float pw_worley = worley_fbm(uvw, Unpack(perlin_worley_worley_floats), 0.67);

    float worley1 = worley_fbm(uvw, Unpack(perlin_worley_1_floats), 1.0);
    float worley2 = worley_fbm(uvw, Unpack(perlin_worley_2_floats), 1.0);
    float worley3 = worley_fbm(uvw, Unpack(perlin_worley_3_floats), 1.0);
    
    
    float perlinWorley = remap(
            pw_perlin,
            0,
            1.0,pw_worley,1.0);
    
    float4 result = float4(
        worley1,
        worley2,
        worley3,
        perlinWorley);
    
    PerlinTex[id.xyz] = float4(result);
}

[numthreads(8,8,8)]
void GenWorley (uint3 id : SV_DispatchThreadID)
{
    float3 uvw = (id.xyz + 0.5) / 128; // Has to match the Worley texture size in NoiseController.
    float3 worley = float3(Worley(uvw, w_worley_1_base_frequency_global), Worley(uvw, w_worley_2_base_frequency_global), Worley(uvw, w_worley_3_base_frequency_global));
    
    WorleyTex[id.xyz] = saturate(float4(1.0 - worley.xyz, 1.0));
}

[numthreads(8,8,1)]
void gen_weather (uint3 id : SV_DispatchThreadID)
{
    float3 uvw = float3((id.xy + 0.5) / 512, 0);


    /*float mask = Perlin(uvw, 2);
    mask = smoothstep(-0.4, 0.6, mask);
    
    float detail = Perlin(uvw, 4) * 0.625 + Perlin(uvw, 8) * 0.25 + Perlin(uvw, 16) * 0.125;
    detail = saturate(detail + 0.5);
   
    float result = mask * detail;*/
    
    float result = perlin_fbm(uvw ,Unpack(weather_floats));
    int v = result * 10000.0;
    InterlockedMin(min_max_buffer[0], v);
    InterlockedMax(min_max_buffer[1], v);
    result = remap(result, 0.31, 0.74, -0.5, 1.0);
    
    float cloud_type = 1;
    if (distance(uvw.xy, float2(0.2, 0.2)) < 0.1)
    {
        cloud_type = 0.5 + saturate(distance(uvw.xy, float2(0.2, 0.2))  * 10 - 0.5);
    }
    
    weather_map[id.xy] = float4(saturate(result), cloud_type, 0.0, 1.0);
}



